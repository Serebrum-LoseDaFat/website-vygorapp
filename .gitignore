# Dependencies and build output. These are regenerated by `npm install` and
# `npm run build`, and together account for ~460 MB — they must never be
# committed. vygor-web/.gitignore covers these too; repeating them here means
# the rule holds even if that file is moved or edited.
node_modules/
.next/
out/
*.tsbuildinfo
next-env.d.ts

# Local environment. .env.example IS tracked and documents every variable;
# .env.local is per-machine and stays out.
.env.local
.env*.local

# Generated web assets are tracked on purpose (vygor-web/public/app and
# /brand): `npm run assets` needs the source artwork to rebuild them, and
# committing the output means a fresh clone can build and run without it.

# OS and editor cruft
.DS_Store
Thumbs.db
desktop.ini
*.swp
.idea/
.vscode/

# Scratch
*.log
