# Dependencies and build output — regenerated by `npm install` and `npm run
# build`, together ~460 MB. Never commit these.
node_modules/
.next/
out/
*.tsbuildinfo
next-env.d.ts

# Local environment. .env.example IS tracked and documents every variable;
# .env.local holds per-machine values and stays out. On Vercel these are set
# under Project -> Settings -> Environment Variables instead.
.env.local
.env*.local

# NOT ignored, on purpose:
#   public/app, public/brand  - generated web assets. Committing them means a
#                               fresh clone builds without needing `npm run
#                               assets` or the source art.
#   assets/                   - the source artwork `npm run assets` reads from.

# OS and editor cruft
.DS_Store
Thumbs.db
desktop.ini
*.swp
.idea/
.vscode/

# Scratch
*.log
