# ---------------------------------------------------------------------------
# Vygor consumer site — external destinations.
# Every value here is optional. Anything left blank makes the matching UI
# hide itself rather than render a dead control. See src/lib/config.ts.
# ---------------------------------------------------------------------------

# Canonical origin, used for metadata, sitemap and Open Graph URLs.
NEXT_PUBLIC_SITE_URL=https://www.vygor.app

# App stores. The iOS link is live today. Android is not published yet —
# fill NEXT_PUBLIC_PLAY_URL in and the Google Play badge appears everywhere.
NEXT_PUBLIC_APP_STORE_URL=https://apps.apple.com/app/apple-store/id1565632505?pt=128960465&ct=Vygor_App&mt=8
NEXT_PUBLIC_PLAY_URL=

# Web sign-in. Vygor has no web login today, so the nav "Log In" control is
# hidden. Set this and it appears automatically.
NEXT_PUBLIC_LOGIN_URL=

# Legal pages, on the existing site.
NEXT_PUBLIC_PRIVACY_URL=https://www.vygor.health/privacy-policy
NEXT_PUBLIC_TERMS_URL=https://www.vygor.health/terms-of-service

# "Partner with us" points at the existing site, which holds the B2B content.
NEXT_PUBLIC_BUSINESS_URL=https://www.vygor.health/

# Social profiles. Blank ones are omitted from the footer. LinkedIn is
# deliberately absent — this is a consumer site.
NEXT_PUBLIC_INSTAGRAM_URL=https://www.instagram.com/vygorapp/
NEXT_PUBLIC_TIKTOK_URL=https://www.tiktok.com/@vygorapp

# The one address the site exposes, on the support section.
NEXT_PUBLIC_SUPPORT_EMAIL=hello@vygor.health

# Where creators send drafts for review. Separate inbox from support.
NEXT_PUBLIC_PARTNERS_EMAIL=partners@vygor.health


# Per-person access keys for the private Apple Ads guide at /apple-ads.
# Comma-separated name:key pairs. The name is only so a key can be matched
# to a person when revoking; nobody types it.
# Generate one with: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
# NOT NEXT_PUBLIC — that prefix would publish every key to the browser.
# Unset, /apple-ads returns 404.
APPLE_ADS_KEYS=
